#!/bin/sh
# funes's pi integration: register this directory with pi as an extension, bind the memory it
# recalls from and publishes to, and convert the sessions pi has already written.
#
# pi has no MCP client, so index.ts is one: it spawns `funes mcp` over stdio and registers whatever
# tools/list returns. It also converts each finished turn into the spool funes indexes.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# The pre-registry install location, unregistered on sight so pi can't load two copies.
LEGACY="$HOME/.funes/integrations/pi"

# The tools' MCP schemas make optional arguments nullable unions, which pi validates correctly only
# from this version on. An older pi registers them, then rejects every call that omits one.
MIN_PI=0.84.0

usage() {
    echo "usage: setup add [MEMORY] | setup remove" >&2
    exit 2
}

have_pi() {
    command -v pi >/dev/null 2>&1
}

# The directory funes drains for this agent. funes hands us its home and our id; the extension sees
# neither, so the resolved path is written beside it.
spool_dir() {
    printf '%s/spool/%s\n' "${FUNES_HOME:-$HOME/.funes}" "${FUNES_AGENT_ID:-pi}"
}

# Where pi keeps its sessions: either override it honours, else the default.
sessions_dir() {
    if [ -n "${PI_CODING_AGENT_SESSION_DIR:-}" ]; then
        printf '%s\n' "$PI_CODING_AGENT_SESSION_DIR"
    else
        printf '%s/sessions\n' "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
    fi
}

# Convert what pi has already written, so recall reaches it before the next turn. The extension runs
# the same module inside pi, which needs nothing installed; from a shell it needs a JS runtime, and
# where there is none the extension does this itself at its next start.
seed() {
    spool=$1
    sessions=$(sessions_dir)
    [ -d "$sessions" ] || return 0
    for js in node bun deno; do
        if command -v "$js" >/dev/null 2>&1; then
            "$js" "$HERE/convert.mjs" "$sessions" "$spool" >/dev/null
            rm -f "$HERE/seed-pending"
            return 0
        fi
    done
    printf '%s\n' "$sessions" >"$HERE/seed-pending"
    echo "no JS runtime on PATH to convert your existing pi sessions — pi will convert them itself" \
        "the next time it starts." >&2
}

# The version pi reports, or empty when it reports something with no version in it.
pi_version() {
    pi --version 2>/dev/null | awk 'match($0, /[0-9]+(\.[0-9]+)+/) { print substr($0, RSTART, RLENGTH); exit }'
}

# True when version $1 is older than version $2.
older() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        split(a, x, "."); split(b, y, ".")
        for (i = 1; i <= 3; i++) {
            if ((x[i] + 0) < (y[i] + 0)) exit 0
            if ((x[i] + 0) > (y[i] + 0)) exit 1
        }
        exit 1
    }'
}

drop_legacy() {
    [ -d "$LEGACY" ] || return 0
    if have_pi; then
        pi remove "$LEGACY" >/dev/null 2>&1 || true
    fi
    rm -rf "$LEGACY"
}

add() {
    # The memory index.ts reads at startup; absent is the local memory.
    if [ -n "${1:-}" ]; then
        printf '%s\n' "$1" >"$HERE/memory"
    else
        rm -f "$HERE/memory"
    fi

    spool=$(spool_dir)
    mkdir -p "$spool"
    printf '%s\n' "$spool" >"$HERE/spool"
    # The sessions root, for the extension's sweep: a session pi was pointed elsewhere is swept
    # in its own directory alone.
    sessions_dir >"$HERE/sessions"
    seed "$spool"

    drop_legacy

    if ! have_pi; then
        echo "the funes pi extension is installed at $HERE"
        echo "\`pi\` isn't on PATH — once it is, run:  pi install $HERE"
        return 0
    fi

    version=$(pi_version)
    if [ -n "$version" ] && older "$version" "$MIN_PI"; then
        echo "pi $version is too old for funes — the tools need pi $MIN_PI or newer to accept their" \
            "arguments. Run \`pi update\`, then re-run this command. The extension is installed at" \
            "$HERE either way." >&2
        exit 1
    fi

    pi install "$HERE"
    echo "installed funes into pi${version:+ $version} — recall and per-turn indexing are now active" \
        "(restart pi if it's running)."
}

remove() {
    # The spool holds converted copies of pi's own sessions, so dropping it loses nothing a re-add
    # cannot rebuild — and leaving it would have funes keep indexing an agent it no longer serves.
    rm -rf "$(spool_dir)"
    rm -f "$HERE/memory" "$HERE/spool" "$HERE/sessions" "$HERE/seed-pending" "$HERE/swept"
    drop_legacy

    if ! have_pi; then
        echo "\`pi\` isn't on PATH — the extension and its automation were removed. Once it is," \
            "remove the registration manually:  pi remove $HERE"
        return 0
    fi

    # A registration pi has already forgotten is a success.
    if ! out=$(pi remove "$HERE" 2>&1); then
        case "$out" in
        *"No matching package found for"*) : ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1
            ;;
        esac
    fi
    echo "removed funes from pi — extension registration, its automation, and the extracted files."
}

case "${1:-}" in
add)
    shift
    [ $# -le 1 ] || usage
    add "${1:-}"
    ;;
remove)
    shift
    [ $# -eq 0 ] || usage
    remove
    ;;
*) usage ;;
esac
