#!/bin/sh
# funes's Claude Code integration: register `funes mcp` as a user-scoped MCP server, and install a
# hooks-only plugin that indexes each turn and, with a memory bound, publishes at session
# boundaries. funes never edits the user's settings.json.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT="$HERE/claude-plugin"
PLUGIN_ID="funes@huggingface"
MARKETPLACE="huggingface"

# The pre-registry install location. The marketplace is registered by name against it, so `add`
# drops that registration before pointing the name at the new path.
LEGACY="$HOME/.funes/integrations/claude-plugin"

FUNES="${FUNES_BIN:-funes}"

usage() {
    echo "usage: setup add [MEMORY] | setup remove" >&2
    exit 2
}

have_claude() {
    command -v claude >/dev/null 2>&1
}

# The directory funes drains for this agent. funes hands us its home and our id; the hook sees
# neither, so the resolved path is written beside it.
spool_dir() {
    printf '%s/spool/%s\n' "${FUNES_HOME:-$HOME/.funes}" "${FUNES_AGENT_ID:-claude}"
}

# Claude Code's transcripts are JSONL that has to become funes's own, which needs a JSON parser;
# POSIX sh has none and the native installer ships a single binary, so the converter needs jq and
# there is nothing to capture without it. Refuse before touching anything rather than install an
# integration that can never index.
#
# The check is a conversion, not a version string: macOS 15 ships an `/usr/bin/jq` that reports 1.6
# while being a pre-1.7 snapshot, and a jq built without its regex engine would pass a version gate
# and then mis-split every block.
require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "funes's Claude Code integration needs jq to convert its transcripts, and it is not on PATH." >&2
        echo "  macOS    already at /usr/bin/jq on 15 and newer" >&2
        echo "  Debian   sudo apt install jq" >&2
        echo "  Fedora   sudo dnf install jq" >&2
        echo "  Alpine   apk add jq" >&2
        echo "Install it, then run \`funes add claude\` again." >&2
        exit 1
    fi
    if ! "$PLUGIN_ROOT/funes/test/run.sh" >/dev/null 2>&1; then
        echo "the jq on PATH does not convert Claude Code's transcripts the way funes reads them — run" >&2
        echo "\`$PLUGIN_ROOT/funes/test/run.sh\` to see how it differs. funes needs a stock jq 1.6 or newer." >&2
        exit 1
    fi
}

# Convert the transcripts Claude Code has already written, so recall reaches them before the next
# turn. Sub-agent transcripts nest under their session's directory and are picked up by the same
# walk.
seed() {
    spool=$1
    projects="$HOME/.claude/projects"
    [ -d "$projects" ] || return 0
    find "$projects" -type f -name '*.jsonl' | while IFS= read -r src; do
        stem=${src##*/}
        "$PLUGIN_ROOT/funes/convert" "$src" "$spool/${stem%.jsonl}.funes.jsonl" || true
    done
}

# The plugin's hooks: a static file per binding, plus the memory in a file the push hook reads. The
# hook commands never carry the memory, so nothing has to generate JSON and this script needs no
# interpreter beyond the shell — the only thing a box running Claude Code is guaranteed to have.
write_hooks() {
    memory=${1:-}
    mkdir -p "$PLUGIN_ROOT/funes/hooks"
    if [ -n "$memory" ]; then
        cp "$HERE/hooks-remote.json" "$PLUGIN_ROOT/funes/hooks/hooks.json"
        printf '%s\n' "$memory" >"$PLUGIN_ROOT/funes/scripts/memory"
    else
        cp "$HERE/hooks-local.json" "$PLUGIN_ROOT/funes/hooks/hooks.json"
        rm -f "$PLUGIN_ROOT/funes/scripts/memory"
    fi
}

manual_add() {
    memory=${1:-}
    echo "  claude plugin marketplace add $PLUGIN_ROOT"
    echo "  claude plugin install $PLUGIN_ID"
    if [ -n "$memory" ]; then
        echo "  claude mcp add funes -s user -- $FUNES mcp $memory"
    else
        echo "  claude mcp add funes -s user -- $FUNES mcp"
    fi
}

add() {
    memory=${1:-}
    require_jq
    write_hooks "$memory"

    spool=$(spool_dir)
    mkdir -p "$spool"
    printf '%s\n' "$spool" >"$PLUGIN_ROOT/funes/scripts/spool"
    seed "$spool"

    if ! have_claude; then
        echo "the funes plugin is installed at $PLUGIN_ROOT"
        echo "\`claude\` isn't on PATH — once it is, run:"
        manual_add "$memory"
        return 0
    fi

    if [ -d "$LEGACY" ]; then
        claude plugin marketplace remove "$MARKETPLACE" >/dev/null 2>&1 || true
    fi
    rm -rf "$LEGACY"

    claude plugin marketplace add "$PLUGIN_ROOT"
    # A plain install is a no-op for an installed plugin and update is version-gated, so refreshed
    # content lands by uninstalling first.
    claude plugin uninstall "$PLUGIN_ID" >/dev/null 2>&1 || true
    claude plugin install "$PLUGIN_ID"

    # `mcp add` errors when funes is already registered, so a re-run to change the memory would
    # fail without this.
    claude mcp remove funes >/dev/null 2>&1 || true
    if [ -n "$memory" ]; then
        claude mcp add funes -s user -- "$FUNES" mcp "$memory"
    else
        claude mcp add funes -s user -- "$FUNES" mcp
    fi

    if [ -n "$memory" ]; then
        echo "installed funes into Claude Code — recall, per-turn indexing, and publishing to $memory (restart Claude Code if it's running)."
    else
        echo "installed funes into Claude Code — recall and per-turn indexing, local only (restart Claude Code if it's running)."
    fi
}

# Run one `claude` removal. A registration claude has already forgotten is a success; any other
# failure keeps its diagnostics rather than claiming a partial uninstall worked.
forget() {
    absent=$1
    shift
    if ! out=$(claude "$@" 2>&1); then
        case "$out" in
        *"$absent"*) : ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1
            ;;
        esac
    fi
}

remove() {
    # The spool holds converted copies of Claude Code's own transcripts, so dropping it loses nothing
    # a re-add cannot rebuild, and leaving it would have funes keep indexing an agent it no longer
    # serves.
    rm -rf "$(spool_dir)" "$LEGACY"
    rm -rf "$PLUGIN_ROOT/funes/scripts/spool" "$PLUGIN_ROOT/funes/scripts/swept"

    if ! have_claude; then
        echo "\`claude\` isn't on PATH — the plugin files were removed. Once it is, remove the registrations manually:"
        echo "  claude mcp remove funes -s user"
        echo "  claude plugin uninstall $PLUGIN_ID"
        echo "  claude plugin marketplace remove $MARKETPLACE"
        return 0
    fi

    forget 'No MCP server named "funes"' mcp remove funes -s user
    forget "Plugin \"$PLUGIN_ID\" not found" plugin uninstall "$PLUGIN_ID"
    forget "Marketplace '$MARKETPLACE' not found" plugin marketplace remove "$MARKETPLACE"
    echo "removed funes from Claude Code — recall registration, hooks plugin, and installed files."
}

case "${1:-}" in
add)
    shift
    [ $# -le 1 ] || usage
    add "${1:-}"
    ;;
remove)
    shift
    [ $# -eq 0 ] || usage
    remove
    ;;
*) usage ;;
esac
