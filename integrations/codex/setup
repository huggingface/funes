#!/bin/sh
# funes's Codex integration: register `funes mcp` as an MCP server, and install a plugin carrying
# the skill Codex lists before any tool is loaded and the hooks that index each turn and, with a
# memory bound, publish at session boundaries. Codex writes its own config.toml; funes never does.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The marketplace root — the plugin itself sits at plugins/funes, where the marketplace points.
PLUGIN_ROOT="$HERE/codex-plugin"
PLUGIN_DIR="$PLUGIN_ROOT/plugins/funes"
PLUGIN_ID="funes@huggingface"
MARKETPLACE="huggingface"

# Where an install before the plugin put funes's files. Codex answers `CODEX_HOME` itself and its
# default lands in `$HOME/.codex`, which is where that install wrote too.
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"

FUNES="${FUNES_BIN:-funes}"

usage() {
    echo "usage: setup add [MEMORY] | setup remove" >&2
    exit 2
}

have_codex() {
    command -v codex >/dev/null 2>&1
}

# The plugin's hooks: a static file per binding, plus the memory in a file the push hook reads. The
# hook commands never carry the memory, so nothing has to generate JSON and this script needs no
# interpreter beyond the shell — the only thing a box running Codex is guaranteed to have.
write_hooks() {
    memory=${1:-}
    if [ -n "$memory" ]; then
        cp "$HERE/hooks-remote.json" "$PLUGIN_DIR/hooks.json"
        printf '%s\n' "$memory" >"$PLUGIN_DIR/scripts/memory"
    else
        cp "$HERE/hooks-local.json" "$PLUGIN_DIR/hooks.json"
        rm -f "$PLUGIN_DIR/scripts/memory"
    fi
}

# Clear what an install before the plugin left in Codex's own tree. The skill and the scripts are
# funes's to delete; `hooks.json` is the user's file, so it goes only when funes wrote every command
# in it — otherwise it is left as it is, along with the scripts its entries still run.
drop_pre_plugin_install() {
    # `skills` is Codex's own root, so only funes's directory in it goes; the shared tree, which
    # every harness implementing the skills standard reads, is funes's own and is pruned when empty.
    rm -rf "$CODEX_DIR/skills/funes" "$HOME/.agents/skills/funes"
    rmdir "$HOME/.agents/skills" "$HOME/.agents" 2>/dev/null || true
    config="$CODEX_DIR/hooks.json"
    if [ -f "$config" ] && grep -qE 'funes-(index|push)\.sh' "$config"; then
        if [ "$(grep -c '"command"' "$config")" = "$(grep -cE '"command".*funes-(index|push)\.sh' "$config")" ]; then
            rm -f "$config"
        else
            echo "$config still holds funes hook entries beside your own — delete the groups whose command runs funes-index.sh or funes-push.sh." >&2
            return 0
        fi
    fi
    rm -f "$CODEX_DIR/hooks/funes-index.sh" "$CODEX_DIR/hooks/funes-push.sh" "$CODEX_DIR/hooks/funes-sync.log"
    rmdir "$CODEX_DIR/hooks" 2>/dev/null || true
}

manual_add() {
    memory=${1:-}
    echo "  codex plugin marketplace add $PLUGIN_ROOT"
    echo "  codex plugin add $PLUGIN_ID"
    if [ -n "$memory" ]; then
        echo "  codex mcp add funes -- $FUNES mcp $memory"
    else
        echo "  codex mcp add funes -- $FUNES mcp"
    fi
}

add() {
    memory=${1:-}
    write_hooks "$memory"
    drop_pre_plugin_install

    if ! have_codex; then
        echo "the funes plugin is installed at $PLUGIN_DIR"
        echo "\`codex\` isn't on PATH — once it is, run:"
        manual_add "$memory"
        return 0
    fi

    if ! codex plugin marketplace add "$PLUGIN_ROOT"; then
        echo "\`codex plugin\` couldn't take funes's marketplace — upgrade Codex (funes's hooks ride in a plugin), then run \`funes add codex\` again." >&2
        exit 1
    fi
    # Installing an installed plugin re-copies the source, so refreshed hooks land without a version
    # bump; `mcp add` overwrites an existing registration, so a re-run may change the memory.
    codex plugin add "$PLUGIN_ID"
    if [ -n "$memory" ]; then
        codex mcp add funes -- "$FUNES" mcp "$memory"
        echo "installed funes into Codex — recall, per-turn indexing, and publishing to $memory."
    else
        codex mcp add funes -- "$FUNES" mcp
        echo "installed funes into Codex — recall and per-turn indexing, local only."
    fi
    # Codex skips a hook until its exact command is trusted, so an install that says nothing here
    # reads as automation that silently never runs.
    echo "run \`/hooks\` in Codex to review and trust them — until then Codex skips them."
}

# Run one `codex` removal. A registration codex has already forgotten is a success; any other
# failure keeps its diagnostics rather than claiming a partial uninstall worked.
forget() {
    absent=$1
    shift
    if ! out=$(codex "$@" 2>&1); then
        case "$out" in
        *"$absent"*) : ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1
            ;;
        esac
    fi
}

remove() {
    drop_pre_plugin_install

    if ! have_codex; then
        echo "\`codex\` isn't on PATH — the plugin files were removed. Once it is, remove the registrations manually:"
        echo "  codex mcp remove funes"
        echo "  codex plugin remove $PLUGIN_ID"
        echo "  codex plugin marketplace remove $MARKETPLACE"
        return 0
    fi

    forget "No MCP server named 'funes' found" mcp remove funes
    codex plugin remove "$PLUGIN_ID"
    forget "is not configured or installed" plugin marketplace remove "$MARKETPLACE"
    echo "removed funes from Codex — recall registration, plugin, hooks, and skill."
}

case "${1:-}" in
add)
    shift
    [ $# -le 1 ] || usage
    add "${1:-}"
    ;;
remove)
    shift
    [ $# -eq 0 ] || usage
    remove
    ;;
*) usage ;;
esac
