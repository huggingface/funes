{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/funes-index.sh\"",
            "timeout": 15,
            "statusMessage": "Indexing turn into funes memory"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/funes-index.sh\" --publish",
            "timeout": 15,
            "statusMessage": "Publishing funes memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/funes-index.sh\" --publish",
            "timeout": 15,
            "statusMessage": "Publishing funes memory"
          }
        ]
      }
    ]
  }
}
